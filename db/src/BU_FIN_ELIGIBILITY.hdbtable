COLUMN TABLE "BU_FIN_ELIGIBILITY" (
  "BUSINESS_UNIT"     NVARCHAR(10)  NOT NULL,
  "FIN_ORG_TYPE"      NVARCHAR(20)  NOT NULL,   -- COMPANY_CODE|PROFIT_CENTER|COST_CENTER|LEDGER
  "FIN_ORG_UNIT"      NVARCHAR(20)  NOT NULL,   -- e.g. '1000'
  "VALID_FROM"        DATE          NOT NULL,
  "VALID_TO"          DATE,                      -- NULL = open ended
  "SUBSCRIPTION_MODE" NVARCHAR(10)  NOT NULL,    -- MANDATORY|OPTIONAL|EXCLUDED
  "ELIGIBLE"          BOOLEAN       DEFAULT TRUE,
  "APPROVAL_REF"      NVARCHAR(40),
  "COMMENTS"          NVARCHAR(500),
  "CREATED_BY"        NVARCHAR(100),
  "CREATED_AT"        TIMESTAMP,
  "CHANGED_BY"        NVARCHAR(100),
  "CHANGED_AT"        TIMESTAMP,
  PRIMARY KEY ("BUSINESS_UNIT","FIN_ORG_TYPE","FIN_ORG_UNIT","VALID_FROM")
)